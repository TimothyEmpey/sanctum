{
  "name": "uriel",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "uriel": "./bin/uriel",
    "fonzo": "./bin/fonzo",
    "sanctum": "./bin/sanctum"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "worker": "node --import tsx src/worker.ts",
    "db:up": "bash scripts/postgres.sh",
    "postinstall": "prisma generate",
    "replay": "node --import tsx scripts/replay.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate"
  },
  "prisma": {
    "seed": "tsx --tsconfig tsconfig.json prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-slot": "^1.3.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "15.5.27",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "postcss": "8.5.31"
  }
}
