#!/bin/bash
# Sanctum remains an alias for the single NQ/ES Uriel worker.
set -euo pipefail
source="${BASH_SOURCE[0]}"
while [ -L "$source" ]; do
  dir="$(cd "$(dirname "$source")" && pwd)"
  source="$(readlink "$source")"
  [[ "$source" != /* ]] && source="$dir/$source"
done
root="$(cd "$(dirname "$source")/.." && pwd)"
export SANCTUM_DESK=sanctum
exec "$root/bin/uriel" "$@"
